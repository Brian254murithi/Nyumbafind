# Copy this file to ".env" and adjust the values. Never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave empty for SQLite (default). For PostgreSQL provide a URL such as:
# postgres://user:password@127.0.0.1:5432/nyumbafind
DATABASE_URL=

# --- CORS (only needed if the frontend is served from another origin/port) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- AI assistant ---
# "rule_based" (default, no key needed) or "openai" (requires OPENAI_API_KEY)
AI_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT=10/min

# --- Map tiles (optional) ---
# Leave MAP_TILE_URL empty to use the built-in providers
# (OpenStreetMap primary, CARTO automatic fallback).
# Override the primary with any Leaflet-compatible URL
# containing {z}/{x}/{y} (and {s} for subdomains).
# If the provider needs an API key, set it here — it is
# injected server-side and never committed to the code.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_API_KEY=

# --- M-Pesa Daraja ---
# sandbox or production. Get credentials from
# https://developer.safaricom.co.ke after registering an app.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Safaricom will call back, e.g.
# https://your-domain.com/api/payments/callback/
MPESA_CALLBACK_URL=
# Optional: registered Daraja initiator credentials for
# TransactionStatusQuery (reconciliation only).
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
